# Destinos dos links do acervo binário mantido no Google Drive.
# Copie para .env, ajuste os caminhos e rode: bash scripts/link-acervo.sh
# Use aspas se o caminho tiver espaços.

# Textos normativos de referência (PDFs) -> local/normative-sources
CGOV_NORMATIVE_SOURCES="/mnt/c/Users/<usuario>/My Drive/<pasta>/CGOV/normative-sources"

# Acervo binário das análises (PDF, PNG, PPTX) -> local/acervo-drive
CGOV_ACERVO_DRIVE="/mnt/c/Users/<usuario>/My Drive/<pasta>/CGOV/_acervo-escritorio-virtual"
